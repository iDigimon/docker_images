FROM python:3.10
LABEL authors="avar"
SHELL ["/bin/bash", "-c"]
ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1
RUN apt-get update  && apt-get upgrade -y && apt install -y  tzdata

RUN cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo 'Asia/Shanghai'>/etc/timezone


WORKDIR /venv
# 创建虚拟环境
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"
ENV VIRTUAL_ENV=/venv

COPY requirements.python-3.10.txt /tmp/requirements.python-3.10.txt
RUN python -m pip install --no-cache-dir "pip==26.2.2" \
    && python -m pip install --no-cache-dir -r /tmp/requirements.python-3.10.txt
